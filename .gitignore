# Temporary files
tmp/

# Node.js(ハーネス専用: husky / lint-staged / secretlint)
node_modules/
npm-debug.log*

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
doc/api/

# Flutter の生成物のうち *.g.dart / *.drift.dart は追跡する。
# CI でコード生成を回さずに済み、スキーマ変更の差分がレビューで見えるため
# (方針: .steering/20260912-kickoff-flutter-setup/design.md)。

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
**/*.mobileprovision
**/*.p12

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore
**/gradle-wrapper.jar

# IDE / エディタ
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Testing
coverage/

# Steering files (.steering/) は履歴としてコミットする(CLAUDE.md の方針に従う)

.claude/settings.local.json
.claude/.lint-on-edit.lock

# devcontainer が features 解決時に生成するロックファイル(環境ごとに揺れるため追跡しない)
.devcontainer/devcontainer-lock.json

# Codex 併用ハーネスのローカル状態
# .harness/ を丸ごと無視しないこと: .harness/decisions.jsonl は
# 「削除禁止・追記のみ」の永続ログで、追跡対象に残す必要がある。
.harness/mode
.harness/codex-runs/
